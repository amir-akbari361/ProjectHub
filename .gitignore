# --- Secrets: RSA JWT signing keys ---------------------------------------------------------------
# The dev private key is generated locally (scripts/generate-jwt-key.ps1) and must NEVER be committed.
# In Docker/prod the key arrives via the Jwt__PrivateKeyPem environment variable, not a file.
keys/
**/keys/
*.pem

