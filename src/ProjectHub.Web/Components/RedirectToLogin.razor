@* WHY THIS COMPONENT EXISTS
   ------------------------
   When <AuthorizeRouteView> decides the user is NOT authorized, it renders whatever we put in its
   <NotAuthorized> slot. The naive approach — calling Navigation.NavigateTo(...) inline inside that
   slot — throws "Cannot provide a value for property 'AuthenticationService' ... no registered service
   of type 'Microsoft.AspNetCore.Components.Authorization.IAuthenticationService'". That service belongs
   to the server-rendered Identity/cookie auth stack (AddAuthentication()/AddAuthenticationStateSerialization),
   which we intentionally do NOT use: our Web app is a pure client of the API and derives identity by
   decoding the JWT in TokenStore. So we must perform the redirect ourselves, and we must do it AFTER the
   component has rendered — never during the synchronous render pass — otherwise Blazor treats a mid-render
   navigation as a framework-driven auth challenge and reaches for that missing service.

   Doing the navigation in OnAfterRender (a) runs on the client circuit where NavigationManager is fully
   available, and (b) happens outside the render tree so it never trips the AuthenticationService lookup.
   We also capture the current URL as returnUrl so the login page can send the user back where they aimed. *@
@inject NavigationManager Navigation

<MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
<MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary">
    Redirecting to sign in…
</MudText>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        // Only redirect once, on the first render, to avoid a navigation loop if the component
        // re-renders while the browser is still processing the previous NavigateTo.
        if (!firstRender)
        {
            return;
        }

        // Build a relative return URL from the page the user was denied, so /login can bounce them back.
        var target = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnUrl = Uri.EscapeDataString("/" + target);

        // forceLoad:false keeps this as a client-side (SignalR) navigation — no full page reload,
        // which preserves the in-memory TokenStore state across the hop to /login.
        Navigation.NavigateTo($"login?returnUrl={returnUrl}");
    }
}
