@page "/reset-password"
@using ProjectHub.Web.Client.Http
@using ProjectHub.Web.Client.Models
@inject AuthApiClient AuthApi
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@layout AuthLayout

<PageTitle>Set a new password · ProjectHub</PageTitle>

@* STEP 2 OF THE PASSWORD RESET FLOW: the page the emailed link lands on.

   THE TOKEN ARRIVES IN THE QUERY STRING and is never shown or editable — it is a credential, not user input. We
   only check that it is PRESENT: validating it properly means redeeming it, and it is single-use, so there is no
   way to ask "is this good?" without spending it. A missing token therefore short-circuits to an explanatory
   state rather than rendering a form that is guaranteed to fail.

   A successful reset also revokes every existing session server-side (the API does this deliberately: if the
   password was reset because it leaked, sessions opened with the old one must die). So we send the user to /login
   rather than trying to sign them in here. *@

<div class="ph-auth-card">
    @if (string.IsNullOrWhiteSpace(Token))
    {
        <div class="ph-auth-head">
            <MudIcon Icon="@Icons.Material.Outlined.LinkOff" Color="Color.Warning" Style="font-size:3rem;" />
            <MudText Typo="Typo.h5" Class="ph-auth-title">This link is incomplete</MudText>
        </div>

        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
            The reset link is missing its token. Email clients sometimes truncate long links — request a fresh one
            and open it directly.
        </MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="/forgot-password">
            Request a new link
        </MudButton>
    }
    else
    {
        <div class="ph-auth-head">
            <MudIcon Icon="@Icons.Material.Outlined.Password" Color="Color.Primary" Style="font-size:2.5rem;" />
            <MudText Typo="Typo.h4" Class="ph-auth-title">Set a new password</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Choose a password you have not used here before.
            </MudText>
        </div>

        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="_model.NewPassword"
                          For="@(() => _model.NewPassword)"
                          Label="New password"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                          AdornmentAriaLabel="Toggle password visibility"
                          Immediate="true"
                          Class="mb-3"
                          HelperText="At least 8 characters with uppercase, lowercase, and a digit" />

            <MudTextField @bind-Value="_model.ConfirmPassword"
                          For="@(() => _model.ConfirmPassword)"
                          Label="Confirm new password"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Immediate="true"
                          Class="mb-3" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3 rounded-lg">
                    @_error
                </MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="_busy"
                       Class="ph-auth-submit">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Updating…</span>
                }
                else
                {
                    <span>Update password</span>
                }
            </MudButton>
        </EditForm>

        <div class="ph-auth-foot">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                <MudLink Href="/login" Typo="Typo.body2">Back to sign in</MudLink>
            </MudText>
        </div>
    }
</div>

@code {
    /// <summary>
    /// The one-time reset token from the emailed link. Blazor URL-decodes query parameters for us, so the value
    /// here is the raw token the API expects.
    /// </summary>
    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private sealed class ResetPasswordModel
    {
        // Mirrors the server's password policy so the user sees which rule they broke, on the field that broke it,
        // instead of one summary sentence after a round-trip. The API remains the authority.
        [Required(ErrorMessage = "A new password is required")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters")]
        [RegularExpression(
            @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+$",
            ErrorMessage = "Password must contain an uppercase letter, a lowercase letter, and a digit")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your new password")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private readonly ResetPasswordModel _model = new();
    private bool _busy;
    private bool _showPassword;
    private string? _error;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            return;
        }

        _busy = true;
        _error = null;

        var result = await AuthApi.ResetPasswordAsync(
            new ResetPasswordRequest(Token, _model.NewPassword));

        _busy = false;

        if (!result.IsSuccess)
        {
            // Covers both "the token is expired or already used" and "the new password failed policy". The API's
            // message distinguishes them, so we surface it rather than guessing.
            _error = result.Error ?? "Could not update your password. The link may have expired.";
            return;
        }

        Snackbar.Add("Password updated. Please sign in with your new password.", Severity.Success);
        Nav.NavigateTo("/login");
    }
}
