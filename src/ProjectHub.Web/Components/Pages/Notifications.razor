@page "/notifications"
@attribute [Authorize]
@using ProjectHub.Domain.Enums
@using ProjectHub.Web.Client.Formatting
@using ProjectHub.Web.Client.Http
@using ProjectHub.Web.Client.Models
@using ProjectHub.Web.Client.State
@inject NotificationsApiClient NotificationsApi
@inject NotificationState NotificationBadge
@inject ISnackbar Snackbar

<PageTitle>Notifications · ProjectHub</PageTitle>

@* The inbox, newest first. The All/Unread filter RE-QUERIES rather than filtering the loaded page, so the pager
   below always describes the set actually being shown.

   Every mutation here also updates the shared NotificationState, which is what the app-bar badge renders. Without
   that the badge would keep claiming unread items on a page that visibly has none — the two live in different
   branches of the component tree and can only agree through that service. *@

<PageHeader Title="Notifications" Subtitle="Stay on top of what's happening">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.DoneAll"
                   OnClick="MarkAllAsync"
                   Disabled="@(_working || NotificationBadge.UnreadCount == 0)">
            Mark all read
        </MudButton>
    </Actions>
</PageHeader>

<MudToggleGroup T="bool" Value="_unreadOnly" Color="Color.Primary" Class="mb-4"
                SelectionMode="SelectionMode.SingleSelection" CheckMark="false"
                ValueChanged="OnFilterChangedAsync">
    <MudToggleItem Value="false">All</MudToggleItem>
    <MudToggleItem Value="true">
        @if (NotificationBadge.UnreadCount > 0)
        {
            @($"Unread ({NotificationBadge.UnreadCount})")
        }
        else
        {
            @("Unread")
        }
    </MudToggleItem>
</MudToggleGroup>

@if (_loading)
{
    <ListSkeleton Count="5" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="rounded-lg">@_error</MudAlert>
}
else if (_items.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.NotificationsNone"
                Title="You're all caught up"
                Message="@(_unreadOnly ? "No unread notifications right now." : "No notifications yet.")" />
}
else
{
    <MudStack Spacing="2">
        @foreach (var notification in _items)
        {
            @* Unread rows are full-opacity and bold; read rows are dimmed. The visual weight IS the state, so the
               list can be triaged without reading every line. *@
            <MudPaper Class="ph-card pa-4 d-flex align-center gap-3" Elevation="0" @key="notification.Id"
                      Style="@(notification.IsRead ? "opacity:.65;" : null)">
                <MudIcon Icon="@IconFor(notification.Type)"
                         Color="@(notification.IsRead ? Color.Default : ColorFor(notification.Type))" />

                <div class="flex-grow-1" style="min-width:0;">
                    <MudText Typo="Typo.body1" Style="@(notification.IsRead ? null : "font-weight:600;")">
                        @notification.Message
                    </MudText>
                    <MudTooltip Text="@notification.CreatedAtUtc.ToLocalTime().ToString("f")">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @DisplayText.Humanize(notification.Type) ·
                            @DisplayText.RelativeTime(notification.CreatedAtUtc)
                        </MudText>
                    </MudTooltip>
                </div>

                @if (!notification.IsRead)
                {
                    <MudTooltip Text="Mark as read">
                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small"
                                       Color="Color.Primary"
                                       Disabled="@(_busyId == notification.Id)"
                                       aria-label="Mark as read"
                                       OnClick="@(() => MarkOneAsync(notification))" />
                    </MudTooltip>
                }
            </MudPaper>
        }
    </MudStack>

    @if (_totalPages > 1)
    {
        <div class="d-flex justify-center mt-6">
            <MudPagination Color="Color.Primary" Count="_totalPages" Selected="_pageNumber"
                           SelectedChanged="OnPageChangedAsync" />
        </div>
    }
}

@code {
    private const int PageSize = 20;

    private bool _loading = true;
    private bool _working;
    private string? _error;
    private Guid? _busyId;

    private List<NotificationItem> _items = new();
    private bool _unreadOnly;
    private int _pageNumber = 1;
    private int _totalPages;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // The badge count is refreshed alongside the list so the toggle's "Unread (n)" label and the app bar agree
        // from the first paint, rather than the badge lagging until the next navigation.
        await NotificationBadge.RefreshAsync();
    }

    /// <summary>
    /// The single load routine behind first render, filtering and paging, so the loading/error handling cannot
    /// diverge between the three.
    /// </summary>
    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await NotificationsApi.ListAsync(_pageNumber, PageSize, _unreadOnly);

        if (!result.IsSuccess || result.Value is null)
        {
            _error = result.Error ?? "Failed to load notifications.";
            _items = new();
            _totalPages = 0;
        }
        else
        {
            _items = result.Value.Items;
            _totalPages = result.Value.TotalPages;
            _pageNumber = result.Value.PageNumber;
        }

        _loading = false;
    }

    private async Task OnFilterChangedAsync(bool unreadOnly)
    {
        _unreadOnly = unreadOnly;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int page)
    {
        _pageNumber = page;
        await LoadAsync();
    }

    private async Task MarkOneAsync(NotificationItem notification)
    {
        _busyId = notification.Id;
        var result = await NotificationsApi.MarkAsReadAsync(notification.Id);
        _busyId = null;

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error ?? "Failed to mark as read.", Severity.Error);
            return;
        }

        // Decrement locally instead of refetching the count: the outcome is known, and one fewer round-trip on an
        // action a user often repeats several times in a row.
        NotificationBadge.SetUnreadCount(NotificationBadge.UnreadCount - 1);

        if (_unreadOnly)
        {
            // Under the unread filter the row no longer belongs in the set, so the page must be re-queried — the
            // server decides what fills its place, and the total has changed.
            await LoadAsync();
            return;
        }

        // Under "All" the row stays put and simply changes weight. Mutating it in place keeps the user's scroll
        // position, which a reload would throw away mid-triage.
        notification.IsRead = true;
        notification.ReadAtUtc = DateTime.UtcNow;
    }

    private async Task MarkAllAsync()
    {
        _working = true;
        var result = await NotificationsApi.MarkAllAsReadAsync();
        _working = false;

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error ?? "Failed to mark all as read.", Severity.Error);
            return;
        }

        NotificationBadge.SetUnreadCount(0);
        Snackbar.Add("All notifications marked as read.", Severity.Success);
        await LoadAsync();
    }

    /// <summary>Maps a notification type to a representative icon so the list scans by shape, not just text.</summary>
    private static string IconFor(NotificationType type) => type switch
    {
        NotificationType.TaskAssigned => Icons.Material.Filled.AssignmentInd,
        NotificationType.TaskStatusChanged => Icons.Material.Filled.SwapHoriz,
        NotificationType.CommentAdded => Icons.Material.Filled.Comment,
        NotificationType.MentionedInComment => Icons.Material.Filled.AlternateEmail,
        NotificationType.ProjectInvitation => Icons.Material.Filled.GroupAdd,
        NotificationType.SprintStarted => Icons.Material.Filled.PlayCircleOutline,
        _ => Icons.Material.Filled.Notifications
    };

    /// <summary>
    /// Tints an unread notification by kind. A direct mention is the one type that warrants a warning colour — it
    /// is addressed to you personally and usually wants a reply.
    /// </summary>
    private static Color ColorFor(NotificationType type) => type switch
    {
        NotificationType.MentionedInComment => Color.Warning,
        NotificationType.ProjectInvitation => Color.Secondary,
        _ => Color.Primary
    };
}
