@page "/"
@attribute [Authorize]
@using ProjectHub.Domain.Enums
@using ProjectHub.Web.Client.Http
@using ProjectHub.Web.Client.Models
@using ProjectHub.Web.Client.State
@inject ProjectsApiClient ProjectsApi
@inject NotificationState Notifications
@inject NavigationManager Nav

<PageTitle>Dashboard · ProjectHub</PageTitle>

@* The landing surface: headline counts plus the projects the user touched most recently.

   WHY THE COUNTS ARE FETCHED SEPARATELY INSTEAD OF DERIVED FROM THE PROJECT LIST
   The previous version computed "Active" and "Archived" with LINQ over the ONE page of projects it had loaded,
   which silently reported the composition of the first 12 rows as though it were the whole workspace — a user
   with 30 projects saw numbers that were simply wrong, and wrong in a way that looked plausible. Each tile now
   asks the server for the real total using a single-row page and reads TotalCount off the paging envelope, so a
   count costs one row over the wire and is always correct. *@

<PageHeader Title="Dashboard" Subtitle="Your workspace at a glance">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Nav.NavigateTo("/projects"))">
            New Project
        </MudButton>
    </Actions>
</PageHeader>

<MudGrid Class="mb-6">
    <MudItem xs="12" sm="6" md="3">
        <StatTile Label="Total Projects" Value="@_totalProjects" Loading="_loadingStats"
                  Icon="@Icons.Material.Filled.Folder" GradientClass="ph-grad-indigo" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatTile Label="Active" Value="@_activeProjects" Loading="_loadingStats"
                  Icon="@Icons.Material.Filled.RocketLaunch" GradientClass="ph-grad-emerald" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatTile Label="Archived" Value="@_archivedProjects" Loading="_loadingStats"
                  Icon="@Icons.Material.Filled.Inventory2" GradientClass="ph-grad-amber" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatTile Label="Unread" Value="@Notifications.UnreadCount" Loading="false"
                  Icon="@Icons.Material.Filled.NotificationsActive" GradientClass="ph-grad-violet"
                  Href="/notifications" />
    </MudItem>
</MudGrid>

<div class="d-flex align-center justify-space-between mb-3">
    <MudText Typo="Typo.h6" Style="font-weight:700;">Recent Projects</MudText>
    @if (_projects.Count > 0)
    {
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   Href="/projects">
            View all
        </MudButton>
    }
</div>

@if (_loadingProjects)
{
    <CardGridSkeleton Count="3" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="rounded-lg">@_error</MudAlert>
}
else if (_projects.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.FolderOff"
                Title="No projects yet"
                Message="Create your first project to get started.">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Nav.NavigateTo("/projects"))">
                New Project
            </MudButton>
        </Actions>
    </EmptyState>
}
else
{
    <MudGrid>
        @foreach (var project in _projects)
        {
            <MudItem xs="12" sm="6" md="4" @key="project.Id">
                <ProjectCard Project="project" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    /// <summary>How many recent projects the grid shows. Six fills two rows of three on desktop.</summary>
    private const int RecentProjectCount = 6;

    private bool _loadingProjects = true;
    private bool _loadingStats = true;
    private string? _error;

    private List<ProjectListItem> _projects = new();
    private int _totalProjects;
    private int _activeProjects;
    private int _archivedProjects;

    protected override async Task OnInitializedAsync()
    {
        // The recent list and the three counts are independent reads, so they are issued CONCURRENTLY rather than
        // awaited in sequence — four round-trips one after another would make the dashboard the slowest page in
        // the app for no reason. Each task owns its own failure handling so a failed count cannot blank the list.
        var recentTask = LoadRecentProjectsAsync();
        var statsTask = LoadStatsAsync();

        await Task.WhenAll(recentTask, statsTask);
    }

    private async Task LoadRecentProjectsAsync()
    {
        var result = await ProjectsApi.ListAsync(
            pageNumber: 1,
            pageSize: RecentProjectCount,
            sortDescending: true);

        if (!result.IsSuccess || result.Value is null)
        {
            _error = result.Error ?? "Failed to load projects.";
        }
        else
        {
            _projects = result.Value.Items;
        }

        _loadingProjects = false;
    }

    private async Task LoadStatsAsync()
    {
        // All three counts are fetched concurrently for the same reason as above.
        var totalTask = CountAsync(status: null);
        var activeTask = CountAsync(ProjectStatus.Active);
        var archivedTask = CountAsync(ProjectStatus.Archived);

        var counts = await Task.WhenAll(totalTask, activeTask, archivedTask);

        _totalProjects = counts[0];
        _activeProjects = counts[1];
        _archivedProjects = counts[2];
        _loadingStats = false;
    }

    /// <summary>
    /// Reads how many projects match a status WITHOUT transferring them: request the smallest legal page and take
    /// the envelope's <c>TotalCount</c>, which the server computes anyway to build its paging metadata.
    /// </summary>
    /// <remarks>
    /// A failed count returns 0 rather than propagating. A tile is ambient information; surfacing "could not load
    /// the archived count" as a page-level error would be disproportionate, and the list below carries the error
    /// that actually matters.
    /// </remarks>
    private async Task<int> CountAsync(ProjectStatus? status)
    {
        var result = await ProjectsApi.ListAsync(pageNumber: 1, pageSize: 1, status: status);

        return result.IsSuccess && result.Value is not null ? result.Value.TotalCount : 0;
    }
}
