@page "/login"
@using System.ComponentModel.DataAnnotations
@using ProjectHub.Web.Client.Http
@using ProjectHub.Web.Client.Models
@inject AuthApiClient AuthApi
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@layout AuthLayout

<PageTitle>Sign in · ProjectHub</PageTitle>

@* Left brand panel + right form is composed by AuthLayout. This page only owns the form card. *@
<div class="ph-auth-card">
    <div class="ph-auth-head">
        <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" Style="font-size:2.5rem;" />
        <MudText Typo="Typo.h4" Class="ph-auth-title">Welcome back</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">Sign in to continue to ProjectHub</MudText>
    </div>

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />

        <MudTextField @bind-Value="_model.Email"
                      For="@(() => _model.Email)"
                      Label="Email"
                      Variant="Variant.Outlined"
                      InputType="InputType.Email"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Email"
                      Immediate="true"
                      Class="mb-3" />

        <MudTextField @bind-Value="_model.Password"
                      For="@(() => _model.Password)"
                      Label="Password"
                      Variant="Variant.Outlined"
                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                      Immediate="true"
                      Class="mb-1" />

        <div class="d-flex justify-end mb-3">
            <MudLink Href="/forgot-password" Typo="Typo.body2">Forgot password?</MudLink>
        </div>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3 rounded-lg">
                @_error
            </MudAlert>
        }

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   Disabled="_busy"
                   Class="ph-auth-submit">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Signing in…</span>
            }
            else
            {
                <span>Sign in</span>
            }
        </MudButton>
    </EditForm>

    <div class="ph-auth-foot">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Don't have an account?
            <MudLink Href="/register" Typo="Typo.body2" Class="ml-1">Create one</MudLink>
        </MudText>
    </div>
</div>

@code {
    // A dedicated view-model with DataAnnotations gives us inline field validation via <DataAnnotationsValidator/>
    // before we ever hit the network. The API still validates authoritatively (FluentValidation), but this
    // catches obvious mistakes instantly and keeps the button-disabled logic simple.
    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Enter a valid email address")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;
    }

    private readonly LoginModel _model = new();
    private bool _busy;
    private bool _showPassword;
    private string? _error;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var result = await AuthApi.LoginAsync(new LoginRequest(_model.Email.Trim(), _model.Password));

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error ?? "Unable to sign in. Please check your credentials.";
            return;
        }

        Snackbar.Add("Welcome back!", Severity.Success);
        Nav.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl);
    }
}
