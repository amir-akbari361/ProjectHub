@page "/forgot-password"
@using ProjectHub.Web.Client.Http
@using ProjectHub.Web.Client.Models
@inject AuthApiClient AuthApi
@layout AuthLayout

<PageTitle>Reset your password · ProjectHub</PageTitle>

@* STEP 1 OF THE PASSWORD RESET FLOW: ask for the address, and have the API email a one-time link.

   WHY SUCCESS IS SHOWN EVEN FOR AN UNKNOWN ADDRESS
   The API deliberately returns 204 whether or not the email maps to an account, because a distinguishable
   response would turn this endpoint into an account-enumeration oracle — an attacker could harvest which
   addresses are registered. The UI has to keep that promise: it says "if that address has an account, a link is
   on its way", which is true in both cases and leaks nothing. Telling the user "no such account" here would undo
   the server's protection at the last step. *@

<div class="ph-auth-card">
    @if (_sent)
    {
        <div class="ph-auth-head">
            <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead" Color="Color.Success"
                     Style="font-size:3rem;" />
            <MudText Typo="Typo.h5" Class="ph-auth-title">Check your inbox</MudText>
        </div>

        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
            If <strong>@_submittedEmail</strong> has an account, we have sent a password reset link to it. The link
            expires shortly, so use it soon.
        </MudText>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4 rounded-lg">
            Nothing arrived? Check your spam folder, then try again.
        </MudAlert>

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="/login">
            Back to sign in
        </MudButton>
    }
    else
    {
        <div class="ph-auth-head">
            <MudIcon Icon="@Icons.Material.Outlined.LockReset" Color="Color.Primary" Style="font-size:2.5rem;" />
            <MudText Typo="Typo.h4" Class="ph-auth-title">Forgot your password?</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Enter your email and we will send you a reset link.
            </MudText>
        </div>

        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="_model.Email"
                          For="@(() => _model.Email)"
                          Label="Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Email"
                          Immediate="true"
                          Class="mb-3" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3 rounded-lg">
                    @_error
                </MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="_busy"
                       Class="ph-auth-submit">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Sending…</span>
                }
                else
                {
                    <span>Send reset link</span>
                }
            </MudButton>
        </EditForm>

        <div class="ph-auth-foot">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Remembered it?
                <MudLink Href="/login" Typo="Typo.body2" Class="ml-1">Sign in</MudLink>
            </MudText>
        </div>
    }
</div>

@code {
    private sealed class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Enter a valid email address")]
        public string Email { get; set; } = string.Empty;
    }

    private readonly ForgotPasswordModel _model = new();
    private bool _busy;
    private bool _sent;
    private string? _submittedEmail;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var email = _model.Email.Trim();
        var result = await AuthApi.ForgotPasswordAsync(new ForgotPasswordRequest(email));

        _busy = false;

        if (!result.IsSuccess)
        {
            // Only a genuine transport or validation failure lands here — a non-existent account still returns
            // 204, so this branch never reveals whether the address is registered.
            _error = result.Error ?? "Could not send the reset link. Please try again.";
            return;
        }

        _submittedEmail = email;
        _sent = true;
    }
}
