@inherits LayoutComponentBase

@* MudThemeProvider applies the active theme + light/dark palette to every descendant. The @ref lets
   us read its system-preference in OnAfterRender. MudPopoverProvider hosts menus/tooltips; MudDialogProvider
   hosts modal dialogs; MudSnackbarProvider hosts toast notifications. All three must live once, at the
   root, or the corresponding features silently no-op. *@
<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" MaxWidth="MaxWidth.Small" FullWidth="true" BackdropClick="false" />
<MudSnackbarProvider />

<MudLayout>
    @* A frosted-glass, gradient-tinted app bar. Elevation 0 keeps the design flat/modern; the border and
       blur come from the class below so it reads as a "sticky header" rather than a heavy toolbar. *@
    <MudAppBar Elevation="0" Color="Color.Transparent" Class="ph-appbar px-4">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />

        <MudIcon Icon="@Icons.Material.Filled.Hub" Class="ml-2 mr-2" Color="Color.Primary" />
        <MudText Typo="Typo.h6" Class="ph-brand">ProjectHub</MudText>

        <MudSpacer />

        <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleDarkMode" />
        </MudTooltip>

        <MudTooltip Text="Notifications">
            <MudBadge Content="0" Color="Color.Error" Overlap="true" Bordered="true" Visible="false">
                <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" />
            </MudBadge>
        </MudTooltip>

        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Icon="@Icons.Material.Outlined.Person">Profile</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.Settings">Settings</MudMenuItem>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Outlined.Logout">Sign out</MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="@DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Always" Class="ph-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="ph-main">
        @* Error boundary catches unhandled exceptions from any child component and shows a friendly
           fallback instead of tearing down the whole circuit. In dev the raw error still logs. *@
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="rounded-lg">
                        Something went wrong while rendering this page. Please reload.
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider _themeProvider = null!;
    private bool _isDarkMode = true;
    private bool _drawerOpen = true;

    // A single shared theme instance. Defining it here (rather than inline) means every page inherits
    // the same palette/typography and gives us one place to brand the app.
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6366F1",       // indigo
            Secondary = "#8B5CF6",     // violet
            Tertiary = "#06B6D4",      // cyan
            AppbarBackground = "#FFFFFF",
            Background = "#F7F8FC",
            BackgroundGray = "#EEF0F7",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#334155",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Info = "#3B82F6",
            TextPrimary = "#1E293B",
            TextSecondary = "#64748B"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#818CF8",       // lighter indigo for contrast on dark
            Secondary = "#A78BFA",
            Tertiary = "#22D3EE",
            AppbarBackground = "#0F172A",
            Background = "#0B1120",
            BackgroundGray = "#111827",
            Surface = "#161E2E",
            DrawerBackground = "#0F172A",
            DrawerText = "#CBD5E1",
            Success = "#34D399",
            Warning = "#FBBF24",
            Error = "#F87171",
            Info = "#60A5FA",
            TextPrimary = "#E2E8F0",
            TextSecondary = "#94A3B8",
            LinesDefault = "#1E293B",
            TableLines = "#1E293B"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px",
            DrawerWidthLeft = "260px"
        }
    };


    // On first render we can call JS interop, so we ask the browser for its OS-level colour preference
    // and honour it. OnAfterRenderAsync (not OnInitialized) because interop is unavailable during
    // server prerendering. StateHasChanged forces a re-render with the resolved value.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await _themeProvider.GetSystemPreference();
            StateHasChanged();
        }
    }

    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
