@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using ProjectHub.Web.Client.Auth
@using ProjectHub.Web.Client.Http
@using ProjectHub.Web.Client.Realtime
@using ProjectHub.Web.Client.State
@using ProjectHub.Web.Client.Theme
@inject AuthApiClient AuthApi
@inject NotificationState Notifications
@inject NotificationHubClient NotificationHub
@inject ThemePreferenceStore ThemePreference
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@* The provider trio must live once, at the root, or the corresponding features silently no-op:
   MudPopoverProvider hosts menus/tooltips, MudDialogProvider hosts modals, MudSnackbarProvider hosts toasts.
   The theme itself comes from ProjectHubTheme so this layout and AuthLayout cannot drift apart. *@
<MudThemeProvider @ref="_themeProvider" IsDarkMode="_isDarkMode" Theme="ProjectHubTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" MaxWidth="MaxWidth.Small" FullWidth="true" BackdropClick="false" />
<MudSnackbarProvider />

<MudLayout>
    @* A frosted, gradient-tinted app bar. Elevation 0 keeps the design flat; the blur and border come from
       .ph-appbar so it reads as a sticky header rather than a heavy toolbar. *@
    <MudAppBar Elevation="0" Color="Color.Transparent" Class="ph-appbar px-4">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Toggle navigation"
                       OnClick="ToggleDrawer" />

        <MudIcon Icon="@Icons.Material.Filled.Hub" Class="ml-2 mr-2" Color="Color.Primary" />
        <MudText Typo="Typo.h6" Class="ph-brand">ProjectHub</MudText>

        <MudSpacer />

        @* Everything from here on is meaningful only to a signed-in user. This layout also wraps the router's
           <NotAuthorized> content for the single frame before <RedirectToLogin> navigates, and an app bar
           advertising a search box, an inbox and "Signed in as Unknown" to someone on their way to the login page
           is just noise. The theme toggle stays outside the guard: it is a display preference, not an account
           feature, and it works perfectly well for an anonymous visitor. *@
        @if (_authenticated)
        {
            @* Quick search. Enter navigates to the full results page rather than searching inline — the app bar is
               not the place to render a result list, and /search is shareable with its term in the URL. *@
            <div class="ph-appbar-search d-none d-sm-flex mr-2">
                <MudTextField T="string" @bind-Value="_quickSearch"
                              Placeholder="Search…"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Immediate="false"
                              OnKeyUp="OnQuickSearchKeyUp"
                              aria-label="Search projects and tasks" />
            </div>
        }

        <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           aria-label="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                           OnClick="ToggleDarkModeAsync" />
        </MudTooltip>

        @if (_authenticated)
        {
            <NotificationsMenu />

            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                     aria-label="Account menu">
                @* The signed-in identity, read from the JWT we already hold. Shown as a non-interactive header so
                   the user can confirm WHICH account they are acting as before taking an account action. *@
                <div class="px-4 py-2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Signed in as</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@_email</MudText>
                </div>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.Person" Href="/profile">Profile</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="LogoutAsync">Sign out</MudMenuItem>
            </MudMenu>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="@DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Always" Class="ph-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="ph-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @* An ErrorBoundary keeps one misbehaving page from tearing down the whole circuit, which would drop
               the user to a dead browser tab. Recover() lets them retry without a full reload. *@
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <MudPaper Class="ph-card pa-6" Elevation="0">
                        <div class="d-flex align-center gap-3 mb-3">
                            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                            <MudText Typo="Typo.h6" Style="font-weight:700;">Something went wrong</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            This page failed to render. The error has been logged. You can try again, or head back
                            to your dashboard.
                        </MudText>
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="RecoverFromError">
                                Try again
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Href="/">Go to dashboard</MudButton>
                        </div>
                    </MudPaper>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider _themeProvider = null!;
    private ErrorBoundary? _errorBoundary;

    private bool _isDarkMode = true;
    private bool _drawerOpen = true;
    private string? _quickSearch;
    private string? _email;

    // Whether the current visitor is signed in. This layout also wraps the router's <NotAuthorized> content for a
    // single frame while <RedirectToLogin> bounces an anonymous visitor to /login — and during that frame the
    // notification badge must NOT fire a request that can only come back 401, nor render "Signed in as Unknown".
    private bool _authenticated;

    protected override async Task OnInitializedAsync()
    {
        // Re-render the badge whenever the shared count moves — including from the notifications page, which
        // lives in a different branch of the tree and can only reach us through this service.
        Notifications.Changed += OnNotificationsChanged;

        // The badge is chrome on every page, so it must refresh as the user moves around. Subscribing to
        // navigation is what keeps it accurate without a polling timer; see NotificationState for that trade-off.
        // With the hub connected this is belt-and-braces rather than the primary path — deliberately kept, because
        // it is also the ONLY thing keeping the badge honest when the hub cannot connect at all.
        Nav.LocationChanged += OnLocationChanged;

        // Toasts for pushed notifications. Subscribed before the connection is started so no early push is missed.
        NotificationHub.Received += OnNotificationPushed;

        await LoadIdentityAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // JS interop is only available once the circuit is live, so the stored theme choice and the OS preference
        // can only be read here — not in OnInitialized.
        var systemPrefersDark = await _themeProvider.GetSystemPreference();
        _isDarkMode = await ThemePreference.GetIsDarkModeAsync(systemPrefersDark);

        await LoadIdentityAsync();
        await RefreshNotificationsAsync();

        // Only AFTER the identity is known: the hub handshake carries the user's token, so starting it for an
        // anonymous visitor would just be a rejected connection. Started here rather than in OnInitializedAsync
        // because the token lives in localStorage, which needs a live circuit to read.
        await StartNotificationHubAsync();

        StateHasChanged();
    }

    private async Task LoadIdentityAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();

        _authenticated = state.User.Identity?.IsAuthenticated == true;
        _email = state.User.FindFirst(ClaimTypes.Email)?.Value;
    }

    private async Task RefreshNotificationsAsync()
    {
        if (!_authenticated)
        {
            return;
        }
        await Notifications.RefreshAsync();
    }

    private async Task StartNotificationHubAsync()
    {
        if (!_authenticated)
        {
            return;
        }

        // Never throws — a hub that cannot connect logs and leaves the app in its non-real-time mode.
        await NotificationHub.StartAsync();
    }

    private async Task ToggleDarkModeAsync() =>
        _isDarkMode = await ThemePreference.SetIsDarkModeAsync(!_isDarkMode);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void OnQuickSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_quickSearch))
        {
            return;
        }

        // The term travels in the query string so the results page is shareable and survives a reload.
        Nav.NavigateTo($"/search?q={Uri.EscapeDataString(_quickSearch.Trim())}");
        _quickSearch = null;
    }

    private async Task LogoutAsync()
    {
        await AuthApi.LogoutAsync();
        Notifications.SetUnreadCount(0);
        Snackbar.Add("You have been signed out.", Severity.Success);

        // forceLoad:true deliberately. A client-side hop would keep this circuit — and every service holding
        // the previous user's cached data — alive on the login page. A full reload guarantees the next user
        // starts from a genuinely empty state, which matters on a shared machine.
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private void RecoverFromError() => _errorBoundary?.Recover();

    private void OnNotificationsChanged() => InvokeAsync(StateHasChanged);

    // Fired from a SignalR callback on a thread-pool thread, so EVERY line of UI work here has to be marshalled
    // onto the circuit's synchronisation context. Calling Snackbar.Add directly from that thread would mutate the
    // provider's state off the renderer's context — the toast may not appear, or the render can fault.
    // The badge itself needs nothing here: the hub client has already set the count, and NotificationState.Changed
    // re-renders it through OnNotificationsChanged above.
    private void OnNotificationPushed(NotificationPush push) =>
        _ = InvokeAsync(() => Snackbar.Add(push.Message, Severity.Info, config =>
        {
            config.Icon = Icons.Material.Outlined.Notifications;

            // Clicking the toast is the shortest path from "something happened" to the inbox that explains it.
            // NOTE: MudBlazor spells this "Onclick" (lowercase c) — unlike the OnClick parameter on components.
            config.Onclick = _ =>
            {
                Nav.NavigateTo("/notifications");
                return Task.CompletedTask;
            };
        }));

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(RefreshNotificationsAsync);

    public void Dispose()
    {
        // Every subscription outlives a single render, so failing to detach them would leak this layout for the
        // lifetime of the circuit and fire StateHasChanged on a disposed component. The hub CONNECTION itself is
        // not disposed here — it is a circuit-scoped service, so DI tears it down when the circuit ends.
        Notifications.Changed -= OnNotificationsChanged;
        Nav.LocationChanged -= OnLocationChanged;
        NotificationHub.Received -= OnNotificationPushed;
    }
}
