@inherits LayoutComponentBase
@using ProjectHub.Web.Client.Theme
@inject ThemePreferenceStore ThemePreference

@* A chrome-free layout for the authentication pages. It deliberately omits the app bar, drawer and nav — an
   unauthenticated visitor has nowhere to navigate yet. The Mud*Provider trio is still mounted because auth pages
   use snackbars and need the theme applied.

   Keeping this separate from MainLayout is the clean-architecture move for UI: each layout has one
   responsibility and neither leaks the other's concerns. What it does NOT duplicate any more is the palette —
   that comes from ProjectHubTheme, so a rebrand cannot leave the sign-in screen behind. *@
<MudThemeProvider @ref="_themeProvider" IsDarkMode="_isDarkMode" Theme="ProjectHubTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" MaxWidth="MaxWidth.Small" FullWidth="true" BackdropClick="false" />
<MudSnackbarProvider />

<div class="ph-auth-shell">
    @* Left: brand hero. Hidden below 960px (see app.css) so the form owns the full width on a phone. *@
    <div class="ph-auth-hero">
        <div class="ph-auth-hero-content">
            <div class="ph-auth-brand">
                <MudIcon Icon="@Icons.Material.Filled.Hub" Style="font-size:2rem;color:#fff;" />
                <span>ProjectHub</span>
            </div>

            <MudText Typo="Typo.h3" Class="ph-auth-hero-title">Ship work, together.</MudText>
            <MudText Typo="Typo.h6" Class="ph-auth-hero-sub">
                Plan projects, track tasks, and keep your whole team in sync — all in one place.
            </MudText>

            <div class="ph-auth-features">
                <div class="ph-auth-feature">
                    <MudIcon Icon="@Icons.Material.Filled.ViewKanban" />
                    <span>Kanban boards &amp; task workflows</span>
                </div>
                <div class="ph-auth-feature">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" />
                    <span>Roles, permissions &amp; audit trails</span>
                </div>
                <div class="ph-auth-feature">
                    <MudIcon Icon="@Icons.Material.Filled.Notifications" />
                    <span>Comments, files &amp; notifications</span>
                </div>
            </div>
        </div>
    </div>

    @* Right: the centered form column. Each auth page renders its own card into @Body. *@
    <div class="ph-auth-form-col">
        <div class="ph-auth-form-inner">
            @Body
        </div>
    </div>
</div>

@code {
    private MudThemeProvider _themeProvider = null!;
    private bool _isDarkMode = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Read the persisted choice so a user who prefers light mode is not flashed a dark sign-in screen every
        // visit. Only possible after the first render, when JS interop exists.
        var systemPrefersDark = await _themeProvider.GetSystemPreference();
        _isDarkMode = await ThemePreference.GetIsDarkModeAsync(systemPrefersDark);

        StateHasChanged();
    }
}
