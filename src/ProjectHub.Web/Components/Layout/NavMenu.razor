@* A modern navigation menu with pill-shaped active states and semantic icons. The ph-nav class applies
   subtle brand gradients to active links so they feel part of the same visual family as the app bar. *@

<MudNavMenu Class="ph-nav mt-4">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Primary">
        Dashboard
    </MudNavLink>

    <MudNavLink Href="/projects" Icon="@Icons.Material.Filled.Folder" IconColor="Color.Primary">
        Projects
    </MudNavLink>

    <MudDivider Class="my-3 mx-4" />

    <MudNavLink Href="/notifications" Icon="@Icons.Material.Outlined.Notifications" IconColor="Color.Tertiary">
        Notifications
    </MudNavLink>

    <MudNavLink Href="/search" Icon="@Icons.Material.Outlined.Search" IconColor="Color.Tertiary">
        Search
    </MudNavLink>
</MudNavMenu>
