<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    The Web host is a presentation-layer composition root. Like the API it may reference Application
    (to reuse DTOs/contracts) but NEVER Persistence or Infrastructure — the browser tier must not be
    able to touch EF Core or the database directly. All data access goes over HTTP to the API.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ProjectHub.Application\ProjectHub.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MudBlazor: Material-Design component library. Gives us a theme provider, dark mode,
         responsive layout, form inputs with validation adornments, and skeleton loaders. -->
    <PackageReference Include="MudBlazor" Version="7.15.0" />
    <!-- SignalR client so the browser circuit can subscribe to live notifications pushed by the API hub. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
    <!-- JWT parsing for decoding access tokens client-side (read-only, UI convenience). -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
  </ItemGroup>

</Project>
