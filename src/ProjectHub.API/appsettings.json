{
  "ConnectionStrings": {
    "Database": "Server=AMIR;Database=ProjectHub;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "https://api.projecthub.com",
    "Audience": "https://api.projecthub.com",
    "AccessTokenExpirationMinutes": 15
  },
  "FileStorage": {
    "RootPath": "storage/attachments"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/projecthub-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName"],
    "Properties": {
      "Application": "ProjectHub.API"
    }
  },
  "AllowedHosts": "*"
}
